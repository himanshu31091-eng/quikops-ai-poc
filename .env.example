# Anthropic API key for the QuikOps AI Copilot.
#
# Server-side only: it is read in the /api/copilot route handler and never
# reaches the browser. Next.js only exposes variables prefixed NEXT_PUBLIC_,
# and this one deliberately is not.
#
# Leave it unset and the Copilot falls back to Demo AI — answers composed from
# the case record, streamed over the same transport, badged in the panel.
ANTHROPIC_API_KEY=
